{
  "agentPushNotifEnabled": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "autoCompactEnabled": false,
  "autoUpdatesChannel": "stable",
  "cleanupPeriodDays": 90,
  "disableClaudeAiConnectors": true,
  "editorMode": "normal",
  "effortLevel": "high",
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_DISABLE_FILE_CHECKPOINTING": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1",
    "CLAUDE_CODE_EFFORT_LEVEL": "auto",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "DISABLE_TELEMETRY": "1",
    "DO_NOT_TRACK": "1",
    "ENABLE_LSP_TOOL": "1"
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "repo": "anthropics/claude-plugins-official",
        "source": "github"
      }
    }
  },
  "hooks": {
    "ConfigChange": [
      {
        "hooks": [
          {
            "timeout": 5,
            "type": "http",
            "url": "http://127.0.0.1:7788/hooks/event"
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "timeout": 5,
            "type": "http",
            "url": "http://127.0.0.1:7788/hooks/event"
          }
        ]
      }
    ],
    "Elicitation": [
      {
        "hooks": [
          {
            "timeout": 5,
            "type": "http",
            "url": "http://127.0.0.1:7788/hooks/event"
          }
        ]
      }
    ],
    "ElicitationResult": [
      {
        "hooks": [
          {
            "timeout": 5,
            "type": "http",
            "url": "http://127.0.0.1:7788/hooks/event"
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "hooks": [
          {
            "timeout": 5,
            "type": "http",
            "url": "http://127.0.0.1:7788/hooks/event"
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "timeout": 5,
            "type": "http",
            "url": "http://127.0.0.1:7788/hooks/event"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "timeout": 5,
            "type": "http",
            "url": "http://127.0.0.1:7788/hooks/event"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "timeout": 5,
            "type": "http",
            "url": "http://127.0.0.1:7788/hooks/event"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "say '请求授权'",
            "type": "command"
          },
          {
            "timeout": 5,
            "type": "http",
            "url": "http://127.0.0.1:7788/hooks/event"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "timeout": 5,
            "type": "http",
            "url": "http://127.0.0.1:7788/hooks/event"
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "timeout": 5,
            "type": "http",
            "url": "http://127.0.0.1:7788/hooks/event"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "timeout": 5,
            "type": "http",
            "url": "http://127.0.0.1:7788/hooks/event"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "timeout": 5,
            "type": "http",
            "url": "http://127.0.0.1:7788/hooks/event"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "timeout": 5,
            "type": "http",
            "url": "http://127.0.0.1:7788/hooks/event"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "rtk hook claude",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "timeout": 5,
            "type": "http",
            "url": "http://127.0.0.1:7788/hooks/event"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "timeout": 5,
            "type": "http",
            "url": "http://127.0.0.1:7788/hooks/event"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "timeout": 5,
            "type": "http",
            "url": "http://127.0.0.1:7788/hooks/event"
          }
        ]
      }
    ],
    "Setup": [
      {
        "hooks": [
          {
            "timeout": 5,
            "type": "http",
            "url": "http://127.0.0.1:7788/hooks/event"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "jq -r '.last_assistant_message // \"完成了\"' | head -c 40 | say",
            "timeout": 10,
            "type": "command"
          },
          {
            "timeout": 5,
            "type": "http",
            "url": "http://127.0.0.1:7788/hooks/event"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "timeout": 5,
            "type": "http",
            "url": "http://127.0.0.1:7788/hooks/event"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "timeout": 5,
            "type": "http",
            "url": "http://127.0.0.1:7788/hooks/event"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "timeout": 5,
            "type": "http",
            "url": "http://127.0.0.1:7788/hooks/event"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "timeout": 5,
            "type": "http",
            "url": "http://127.0.0.1:7788/hooks/event"
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "timeout": 5,
            "type": "http",
            "url": "http://127.0.0.1:7788/hooks/event"
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "timeout": 5,
            "type": "http",
            "url": "http://127.0.0.1:7788/hooks/event"
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "timeout": 5,
            "type": "http",
            "url": "http://127.0.0.1:7788/hooks/event"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "timeout": 5,
            "type": "http",
            "url": "http://127.0.0.1:7788/hooks/event"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "timeout": 5,
            "type": "http",
            "url": "http://127.0.0.1:7788/hooks/event"
          }
        ]
      }
    ]
  },
  "inputNeededNotifEnabled": true,
  "permissions": {
    "additionalDirectories": [],
    "allow": [
      "Bash(brew:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(source .env)",
      "Bash(uv run *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git pr create *)"
    ],
    "defaultMode": "default",
    "deny": []
  },
  "preferredNotifChannel": "auto",
  "remoteControlAtStartup": false,
  "switchModelsOnFlag": false,
  "teammateMode": "auto"
}